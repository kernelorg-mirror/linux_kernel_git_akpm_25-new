+/*
+ * Negative notify_count counts threads which have not reached exit_notify().
+ * Positive notify_count counts zombies still waiting to be reaped.
+ * tasklist_lock serializes both waits with exit_notify() and __exit_signal().
+ */
+static int wait_for_notify_count(struct task_struct *tsk)
+{
+	struct signal_struct *sig = tsk->signal;
+	int err = 0;
+
+	read_lock(&tasklist_lock);
+	while (sig->notify_count) {
+		set_current_state(TASK_KILLABLE);
+		if (__fatal_signal_pending(tsk)) {
+			err = -EINTR;
+			break;
+		}
+		read_unlock(&tasklist_lock);
+		schedule();
+		read_lock(&tasklist_lock);
+	}
+	read_unlock(&tasklist_lock);
+	__set_current_state(TASK_RUNNING);
+	return err;
+}
+
+static void clear_group_exec_task(struct task_struct *tsk)
+{
+	struct signal_struct *sig = tsk->signal;
+
+	read_lock(&tasklist_lock);
+	spin_lock_irq(&tsk->sighand->siglock);
+	WRITE_ONCE(sig->group_exec_task, NULL);
+	sig->notify_count = 0;
+	spin_unlock_irq(&tsk->sighand->siglock);
+	read_unlock(&tasklist_lock);
+}
