 mm/madvise.c |   13 +++++++++++++
 1 file changed, 13 insertions(+)

--- a/mm/madvise.c~mm-madvise-notify-userfaultfd-when-installing-guard-regions
+++ a/mm/madvise.c
@@ -1163,6 +1163,19 @@ static long madvise_guard_install(struct
 	if (!is_valid_guard_vma(vma, /* allow_locked = */false))
 		return -EINVAL;
 
+	/* userfaultfd_remove() can drop mmap_lock. */
+	if (!userfaultfd_remove(vma, range->start, range->end)) {
+		mark_mmap_lock_dropped(madv_behavior);
+		mmap_read_lock(madv_behavior->mm);
+		madv_behavior->vma = vma = vma_lookup(madv_behavior->mm,
+						    range->start);
+		if (!vma)
+			return -ENOMEM;
+		if (!is_valid_guard_vma(vma, /* allow_locked = */false))
+			return -EINVAL;
+		range->end = min(range->end, vma->vm_end);
+	}
+
