+++ a/tools/testing/selftests/mm/ksm_functional_tests.c
@@ -415,7 +415,7 @@ static void test_unmerge_uffd_wp(void)
 	close(uffd);
 	uffd = syscall(__NR_userfaultfd, O_CLOEXEC | O_NONBLOCK);
 	if (uffd < 0) {
