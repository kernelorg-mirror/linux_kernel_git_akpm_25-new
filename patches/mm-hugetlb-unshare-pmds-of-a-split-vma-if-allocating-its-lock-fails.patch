+++ a/include/linux/hugetlb.h
@@ -274,7 +274,8 @@ long hugetlb_change_protection(struct vm
 		unsigned long cp_flags);
 void hugetlb_unshare_all_pmds(struct vm_area_struct *vma);
 void fixup_hugetlb_reservations(struct vm_area_struct *vma);
-void hugetlb_split(struct vm_area_struct *vma, unsigned long addr);
+void hugetlb_split(struct vm_area_struct *vma, struct vm_area_struct *new,
+		unsigned long addr);
 
 unsigned int arch_hugetlb_cma_order(void);
 
@@ -457,7 +458,8 @@ static inline void fixup_hugetlb_reserva
 {
 }
 
-static inline void hugetlb_split(struct vm_area_struct *vma, unsigned long addr) {}
+static inline void hugetlb_split(struct vm_area_struct *vma,
+		struct vm_area_struct *new, unsigned long addr) {}
 
 #endif /* !CONFIG_HUGETLB_PAGE */
 
--- a/mm/hugetlb.c~mm-hugetlb-unshare-pmds-of-a-split-vma-if-allocating-its-lock-fails
+++ a/mm/hugetlb.c
@@ -4889,7 +4889,8 @@ static int hugetlb_vm_op_split(struct vm
 	return 0;
 }
 
-void hugetlb_split(struct vm_area_struct *vma, unsigned long addr)
+void hugetlb_split(struct vm_area_struct *vma, struct vm_area_struct *new,
+		unsigned long addr)
 {
 	/*
 	 * PMD sharing is only possible for PUD_SIZE-aligned address ranges
@@ -4900,8 +4901,13 @@ void hugetlb_split(struct vm_area_struct
 	 * walks (except hardware and gup_fast()).
 	 */
 	vma_assert_write_locked(vma);
+	vma_assert_write_locked(new);
 	i_mmap_assert_write_locked(vma->vm_file->f_mapping);
 
+	/* Shared PMDs require a hugetlb VMA lock. */
+	if (!__vma_shareable_lock(vma))
+		return;
+
 	if (addr & ~PUD_MASK) {
 		unsigned long floor = addr & PUD_MASK;
 		unsigned long ceil = floor + PUD_SIZE;
@@ -4920,6 +4926,15 @@ void hugetlb_split(struct vm_area_struct
 			hugetlb_unshare_pmds(vma, floor, ceil, /* take_locks = */ false);
 		}
 	}
+
+	/*
+	 * If we failed to allocate the hugetlb VMA lock, unshare everything
+	 * that the new VMA covers.
+	 */
+	if (!__vma_shareable_lock(new))
+		hugetlb_unshare_pmds(new, ALIGN(new->vm_start, PUD_SIZE),
+				     ALIGN_DOWN(new->vm_end, PUD_SIZE),
+				     /* take_locks = */ false);
 }
 
 static unsigned long hugetlb_vm_op_pagesize(struct vm_area_struct *vma)
--- a/mm/vma.c~mm-hugetlb-unshare-pmds-of-a-split-vma-if-allocating-its-lock-fails
+++ a/mm/vma.c
@@ -590,7 +590,7 @@ __split_vma(struct vma_iterator *vmi, st
 	 */
 	vma_adjust_trans_huge(vma, vma->vm_start, addr, NULL);
 	if (vma_is_hugetlb(vma))
-		hugetlb_split(vma, addr);
+		hugetlb_split(vma, new, addr);
 
 	if (new_below) {
 		vma->vm_start = addr;
--- a/tools/testing/vma/include/stubs.h~mm-hugetlb-unshare-pmds-of-a-split-vma-if-allocating-its-lock-fails
