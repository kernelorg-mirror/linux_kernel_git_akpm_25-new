@@ -209,10 +209,11 @@ static inline bool mips_vdso_hres_capabl
 }
 #define __arch_vdso_hres_capable mips_vdso_hres_capable
 
-static __always_inline const struct vdso_data *__arch_get_vdso_data(void)
