@@ -7544,7 +7544,7 @@ void mem_cgroup_migrate(struct folio *ol
 	/* Transfer the charge and the css ref */
 	commit_charge(new, memcg);
 	/*
-	 * If the old folio a large folio and is in the split queue, it needs
