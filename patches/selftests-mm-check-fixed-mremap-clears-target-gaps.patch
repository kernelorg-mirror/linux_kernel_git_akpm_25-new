From: Andrew Morton <akpm@linux-foundation.org>
Subject: selftests/mm: check fixed mremap clears target gaps
Date: Sat, 14 Nov 2026 17:18:09 -0800

The multi-VMA move test unmaps its destination before calling mremap(). 
It therefore misses the case where the source contains a hole and the
corresponding destination page is already mapped.  The fixed move
currently leaves that destination mapping in place after returning success
[1].

Run the existing source-gap case with the destination initially mapped as
well as unmapped, both with and without MREMAP_DONTUNMAP.  After a
successful move, check with mincore() that the destination page
corresponding to the source hole is unmapped.  Also mark a data-pattern
mismatch as a test failure rather than reporting a pass after cleanup.

The two new cases should fail before the mremap fix and pass when a
successful fixed move clears the entire destination range.

Link: https://lore.kernel.org/r/tencent_863C8A01F3C81EBA238F375B16065CBACF08@qq.com [1]
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
Cc: fujunjie <fujunjie1@qq.com>
Cc: Lorenzo Stoakes <ljs@kernel.org>
Cc: Jann Horn <jannh@google.com>

 tools/testing/selftests/mm/mremap_test.c |   38 ++++++++++++++++-----
 1 file changed, 29 insertions(+), 9 deletions(-)

--- a/tools/testing/selftests/mm/mremap_test.c~selftests-mm-check-fixed-mremap-clears-target-gaps
+++ a/tools/testing/selftests/mm/mremap_test.c
@@ -653,12 +653,14 @@ out:
 
 static void mremap_move_multiple_vmas_split(unsigned int pattern_seed,
 					    unsigned long page_size,
-					    bool dont_unmap)
+					    bool dont_unmap,
+					    bool mapped_target)
 {
 	char *test_name = "mremap move multiple vmas split";
 	int mremap_flags = MREMAP_FIXED | MREMAP_MAYMOVE;
 	const size_t size = 10 * page_size;
 	bool success = true;
+	unsigned char vec;
 	char *ptr, *tgt_ptr;
 	int i;
 
@@ -680,7 +682,7 @@ static void mremap_move_multiple_vmas_sp
 		success = false;
 		goto out;
 	}
-	if (munmap(tgt_ptr, size)) {
+	if (!mapped_target && munmap(tgt_ptr, size)) {
 		perror("munmap");
 		success = false;
 		goto out_unmap;
@@ -736,6 +738,15 @@ static void mremap_move_multiple_vmas_sp
 		goto out_unmap;
 	}
 
+	/* The source hole must be unmapped at the destination too. */
+	errno = 0;
+	if (mincore(&tgt_ptr[3 * page_size], page_size, &vec) != -1 ||
+	    errno != ENOMEM) {
+		ksft_print_msg("source hole remains mapped at destination\n");
+		success = false;
+		goto out_unmap;
+	}
+
 	/* Offset into random pattern. */
 	srand(pattern_seed);
 	for (i = 0; i < 2 * page_size; i++)
@@ -755,6 +766,7 @@ static void mremap_move_multiple_vmas_sp
 			if (chr != buf[j]) {
 				ksft_print_msg("page %d offset %d corrupted, expected %d got %d\n",
 					       i, j, chr, buf[j]);
+				success = false;
 				goto out_unmap;
 			}
 		}
@@ -767,11 +779,13 @@ out_unmap:
 		perror("munmap src");
 out:
 	if (success)
-		ksft_test_result_pass("%s%s\n", test_name,
-				      dont_unmap ? " [dontunnmap]" : "");
+		ksft_test_result_pass("%s%s%s\n", test_name,
+				      dont_unmap ? " [dontunnmap]" : "",
+				      mapped_target ? " [mapped target]" : "");
 	else
-		ksft_test_result_fail("%s%s\n", test_name,
-				      dont_unmap ? " [dontunnmap]" : "");
+		ksft_test_result_fail("%s%s%s\n", test_name,
+				      dont_unmap ? " [dontunnmap]" : "",
+				      mapped_target ? " [mapped target]" : "");
 }
 
 #ifdef __NR_userfaultfd
@@ -1296,7 +1310,7 @@ int main(int argc, char **argv)
 	char *rand_addr;
 	size_t rand_size;
 	int num_expand_tests = 2;
-	int num_misc_tests = 11;
+	int num_misc_tests = 13;
 	struct test test_cases[MAX_TEST] = {};
 	struct test perf_test_cases[MAX_PERF_TEST];
 	int page_size;
@@ -1430,8 +1444,14 @@ int main(int argc, char **argv)
 	mremap_shrink_multiple_vmas(page_size, /* inplace= */false);
 	mremap_move_multiple_vmas(pattern_seed, page_size, /* dontunmap= */ false);
 	mremap_move_multiple_vmas(pattern_seed, page_size, /* dontunmap= */ true);
-	mremap_move_multiple_vmas_split(pattern_seed, page_size, /* dontunmap= */ false);
-	mremap_move_multiple_vmas_split(pattern_seed, page_size, /* dontunmap= */ true);
+	mremap_move_multiple_vmas_split(pattern_seed, page_size,
+					 /* dontunmap= */ false, /* mapped_target= */ false);
+	mremap_move_multiple_vmas_split(pattern_seed, page_size,
+					 /* dontunmap= */ true, /* mapped_target= */ false);
+	mremap_move_multiple_vmas_split(pattern_seed, page_size,
+					 /* dontunmap= */ false, /* mapped_target= */ true);
+	mremap_move_multiple_vmas_split(pattern_seed, page_size,
+					 /* dontunmap= */ true, /* mapped_target= */ true);
 	mremap_move_multi_invalid_vmas(maps_fp, page_size);
 	mremap_duplicate_shared(maps_fp, page_size, 0);
 	mremap_duplicate_shared(maps_fp, page_size, page_size);
_
