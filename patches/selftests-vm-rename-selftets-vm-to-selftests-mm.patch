-	if (mem == MAP_FAILED) {
-		ksft_test_result_fail("mmap() failed\n");
-		goto munmap;
-	}
-
-	/* Fault the page in. */
-	tmp = *mem + *smem;
-	asm volatile("" : "+r" (tmp));
-
-	fn(mem, smem, pagesize);
-munmap:
-	munmap(mem, pagesize);
-	if (smem != MAP_FAILED)
-		munmap(smem, pagesize);
-close:
-	close(fd);
-}
