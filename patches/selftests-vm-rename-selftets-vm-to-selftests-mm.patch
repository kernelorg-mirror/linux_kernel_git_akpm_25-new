-
-	if (munlockall()) {
-		perror("munlockall()");
-		goto unmap;
-	}
-
-	if (unlock_onfault_check(map))
-		goto unmap;
-
-	if (mlockall(MCL_CURRENT | MCL_FUTURE)) {
-		perror("mlockall(MCL_CURRENT | MCL_FUTURE)");
-		goto out;
-	}
-
-	if (!lock_check((unsigned long)map))
-		goto unmap;
-
-	if (munlockall()) {
-		perror("munlockall()");
