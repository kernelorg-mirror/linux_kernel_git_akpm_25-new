-static int ksm_cow_time(int mapping, int prot, int timeout, size_t page_size)
-{
-	void *map_ptr;
-	struct timespec start_time, end_time;
-	unsigned long cow_time_ns;
-
-	/* page_count must be less than 2*page_size */
