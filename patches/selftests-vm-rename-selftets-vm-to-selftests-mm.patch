-		return 1;
-	}
-	if (ksm_write_sysfs(KSM_FP("run"), 1))
-		return 1;
-
-	/* Since merging occurs only after 2 scans, make sure to get at least 2 full scans */
-	if (ksm_do_scan(2, start_time, timeout))
-		return 1;
-
-	return 0;
-}
