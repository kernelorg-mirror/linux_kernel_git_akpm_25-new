Testing: On A, without this patch, uid 65534 in
user_u:user_r:user_t:s0, with SELinux enforcing, opened and mapped a
writable shared overlayfs file. mmap() and mprotect() returned 0, but
remap_file_pages() returned EACCES and left page A (byte 65) mapped.
The AVC denied { use } on an fd from user_t to its kernel_t opener;
the recorded backing inode matched the overlay upper file. An ordinary
ext4 file remapped successfully in the same context.

On B, with this patch alone, the overlay remap returned 0 and read the
selected page B (byte 66). After the initial mapping, denying write on
the user-visible file returned EACCES with a file { write } AVC.
Independently denying map permission on the upper file to the saved
mounter SID returned EACCES with a backing-file { map } AVC. The ordinary
ext4 control still succeeded. No kernel warning or oops was observed.

 security/selinux/hooks.c |   34 +++++++++++++++++++++++++++++++---
 1 file changed, 31 insertions(+), 3 deletions(-)

--- a/security/selinux/hooks.c~selinux-recheck-backing-file-permissions-on-remap_file_pages
+++ a/security/selinux/hooks.c
@@ -4179,9 +4179,37 @@ static int selinux_mmap_file(struct file
 			     unsigned long reqprot __always_unused,
 			     unsigned long prot, unsigned long flags)
 {
-	return selinux_mmap_file_common(file, prot,
-					(flags & MAP_TYPE) == MAP_SHARED,
-					false);
+	bool shared = (flags & MAP_TYPE) == MAP_SHARED;
+	const struct path *path;
+	struct common_audit_data ad;
+	int rc;
+
+	if (!file || !(file->f_mode & FMODE_BACKING))
+		return selinux_mmap_file_common(file, prot, shared, false);
+
+	/*
+	 * remap_file_pages() passes the VMA's backing file, not the file
+	 * opened by the caller.  Recheck the saved user file and each
+	 * mounter before checking the backing file under its opener's cred.
+	 */
+	path = backing_file_user_path(file);
+	ad.type = LSM_AUDIT_DATA_PATH;
+	ad.u.path = *path;
+	rc = inode_has_perm(current_cred(), d_inode(path->dentry),
+			    FILE__MAP, &ad);
+	if (rc)
+		return rc;
+
+	rc = __file_map_prot_check(file, prot, shared, false, true);
+	if (rc)
+		return rc;
+
+	rc = backing_mounters_has_perm(file,
+				      file_map_prot_to_av(prot, shared));
+	if (rc)
+		return rc;
+
+	return selinux_mmap_file_common(file, prot, shared, true);
 }
 
