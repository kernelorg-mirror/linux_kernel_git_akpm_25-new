 mm/vmalloc.c |    5 ++---
 1 file changed, 2 insertions(+), 3 deletions(-)

--- a/mm/vmalloc.c~mm-vmalloc-move-resched-point-into-alloc_vmap_area-fix
+++ a/mm/vmalloc.c
@@ -2059,9 +2059,8 @@ retry:
 		spin_unlock(&free_vmap_area_lock);
 
 		/*
-		 * This is not a fast path. Check if yielding is
