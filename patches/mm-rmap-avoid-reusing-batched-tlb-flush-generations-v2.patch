:+	if (!strncmp(current->comm, "kt_move", 7) &&
:+	    atomic_read(&kt_aba_unmaps) == 16384) {
:+		unsigned long until = jiffies + 3 * HZ;
:+
:+		atomic_set(&kt_aba_worker_hold, 1);
:+		pr_info("KT_ABA worker_hold unmaps=16384 pending_work=%d\n",
:+			tlb_ubc->flush_required);
:+		while (!atomic_read(&kt_aba_flusher_committed) &&
:+		       time_before(jiffies, until))
:+			msleep(1);
:+		msleep(1100);
:+		atomic_set(&kt_aba_worker_hold, 0);
:+	}
: 	arch_tlbbatch_flush(&tlb_ubc->arch);
:@@ -744,4 +771,41 @@
:+/* Read only; the submitted patch chooses which counter layout exists. */
:+static void kt_aba_counts(struct mm_struct *mm, s64 *pending, s64 *flushed)
:+{
:+#ifdef TLB_FLUSH_BATCH_FLUSHED_SHIFT
:+	int value = atomic_read(&mm->tlb_flush_batched);
:+
:+	*pending = value & TLB_FLUSH_BATCH_PENDING_MASK;
:+	*flushed = value >> TLB_FLUSH_BATCH_FLUSHED_SHIFT;
:+#else
:+	*pending = atomic64_read(&mm->tlb_flush_batch_pending);
:+	*flushed = atomic64_read(&mm->tlb_flush_batch_flushed);
:+#endif
:+}
:+
:+static void kt_aba_flush_tlb_mm(struct mm_struct *mm)
