From: Andrew Morton <akpm@linux-foundation.org>
Subject: fault-inject: initialize random state on first use
Date: Thu, 5 Nov 2026 10:01:33 -0800

setup_fault_attr() is called by fault-injection boot parameter handlers
before slab and workqueues are initialized.  Its prandom_init_once() call
expands to DO_ONCE(), whose static-key disabling path allocates memory and
schedules work.  A valid fault-injection boot parameter can therefore
crash the kernel before boot completes.

There are also separate prandom_init_once() calls in the debugfs and
configfs setup paths.  Each expansion has its own guard, so configuring
another interface can reseed the shared random state while injection is
already active.

Initialize each CPU's random state on its first draw instead, and remove
the three configuration-time initialization calls.  Seed it using
random_get_entropy() and the CPU number, retaining the warmup used by
prandom_seed_full_state().  This avoids allocation, workqueues and the
cryptographic RNG's potentially sleeping locks on PREEMPT_RT.

The seed is not cryptographically strong, and may be deterministic early
in boot when no entropy source is available.  Fault injection does not
require cryptographic unpredictability.

Disable local interrupts around initialization and generation.  Fault
injection can run from interrupt handlers, including NVMe completion, so
an interrupt must not observe partially initialized state or overwrite an
interrupted generator update.

Fixes: e9bc360b105c ("fault-inject: use prandom where cryptographically secure randomness is not needed")
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
Reported-by: Sang-Heon Jeon <ekffu200098@gmail.com>
Cc: Akinobu Mita <akinobu.mita@gmail.com>
Cc: <stable@vger.kernel.org>
---

 lib/fault-inject.c |   46 ++++++++++++++++++++++++++++++++-----------
 1 file changed, 35 insertions(+), 11 deletions(-)

--- a/lib/fault-inject.c~fault-inject-initialize-random-state-on-first-use
+++ a/lib/fault-inject.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 #include <linux/kernel.h>
 #include <linux/init.h>
+#include <linux/timex.h>
 #include <linux/prandom.h>
 #include <linux/debugfs.h>
 #include <linux/sched.h>
@@ -17,16 +18,45 @@
  * The should_fail() functions use prandom instead of the normal Linux RNG
  * since they don't need cryptographically secure random numbers.
  */
-static DEFINE_PER_CPU(struct rnd_state, fault_rnd_state);
+struct fault_random_state {
+	struct rnd_state rnd;
+	bool initialized;
+};
+
+static DEFINE_PER_CPU(struct fault_random_state, fault_rnd_state);
+
+static void fault_random_seed(struct rnd_state *state)
+{
+	u64 seed = random_get_entropy() ^
+		   ((u64)raw_smp_processor_id() << 32);
+	int i;
+
+	/* Avoid allocation and sleeping RNG locks, including on PREEMPT_RT. */
+	prandom_seed_state(state, seed);
+	/* Preserve the warmup used by prandom_seed_full_state(). */
+	for (i = 0; i < 10; i++)
+		prandom_u32_state(state);
+}
 
 static u32 fault_prandom_u32_below_100(void)
 {
-	struct rnd_state *state;
+	struct fault_random_state *state;
+	unsigned long flags;
 	u32 res;
 
-	state = &get_cpu_var(fault_rnd_state);
-	res = prandom_u32_state(state);
-	put_cpu_var(fault_rnd_state);
+	/*
+	 * Fault injection also runs in interrupt handlers, including NVMe
+	 * completion. Prevent an interrupt from observing partially seeded
+	 * state or overwriting a concurrent update to this CPU's generator.
+	 */
+	local_irq_save(flags);
+	state = this_cpu_ptr(&fault_rnd_state);
+	if (unlikely(!state->initialized)) {
+		fault_random_seed(&state->rnd);
+		state->initialized = true;
+	}
+	res = prandom_u32_state(&state->rnd);
+	local_irq_restore(flags);
 
 	return res % 100;
 }
@@ -50,8 +80,6 @@ int setup_fault_attr(struct fault_attr *
 		return 0;
 	}
 
-	prandom_init_once(&fault_rnd_state);
-
 	attr->probability = probability;
 	attr->interval = interval;
 	atomic_set(&attr->times, times);
@@ -240,8 +268,6 @@ struct dentry *fault_create_debugfs_attr
 	if (IS_ERR(dir))
 		return dir;
 
-	prandom_init_once(&fault_rnd_state);
-
 	debugfs_create_ul("probability", mode, dir, &attr->probability);
 	debugfs_create_ul("interval", mode, dir, &attr->interval);
 	debugfs_create_atomic_t("times", mode, dir, &attr->times);
@@ -456,8 +482,6 @@ static const struct config_item_type fau
 
 void fault_config_init(struct fault_config *config, const char *name)
 {
-	prandom_init_once(&fault_rnd_state);
-
 	config_group_init_type_name(&config->group, name, &fault_config_type);
 }
 EXPORT_SYMBOL_GPL(fault_config_init);
_
