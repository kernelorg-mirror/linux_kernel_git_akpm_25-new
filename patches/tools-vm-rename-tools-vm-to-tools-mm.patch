-				array=(${OPTARG//,/ })
-				xmin=${array[0]}
-				xmax=${array[1]}
-				;;
-			h)
-				usage
-				exit 0
-				;;
-			\?)
-				echo "Invalid option: -$OPTARG" >&2
-				exit 1
-				;;
-			:)
-				echo "-$OPTARG requires an argument." >&2
-				exit 1
-				;;
-		esac
-	done
-
-	return $OPTIND
-}
-
-parse_args()
-{
-	local idx=0
-	local p
-
-	for p in "$@"; do
-		case $mode in
