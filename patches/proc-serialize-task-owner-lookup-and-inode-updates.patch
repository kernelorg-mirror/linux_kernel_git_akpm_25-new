 fs/proc/base.c |   11 +++++++++++
 fs/proc/fd.c   |    2 ++
 2 files changed, 13 insertions(+)

--- a/fs/proc/base.c~proc-serialize-task-owner-lookup-and-inode-updates
+++ a/fs/proc/base.c
@@ -2029,9 +2029,11 @@ int pid_getattr(const struct mnt_idmap *
  */
 void pid_update_inode(struct task_struct *task, struct inode *inode)
 {
+	spin_lock(&inode->i_lock);
 	task_dump_owner(task, inode->i_mode, &inode->i_uid, &inode->i_gid);
 
 	inode->i_mode &= ~(S_ISUID | S_ISGID);
+	spin_unlock(&inode->i_lock);
 	security_task_to_inode(task, inode);
 }
 
@@ -2047,6 +2049,13 @@ static int pid_revalidate(struct inode *
 	struct task_struct *task;
 	int ret = 0;
 
+	/*
+	 * VFS permits -ECHILD from d_revalidate() during RCU-walk and
+	 * retries in ref-walk, where PREEMPT_RT's i_lock may sleep.
+	 */
+	if (IS_ENABLED(CONFIG_PREEMPT_RT) && (flags & LOOKUP_RCU))
+		return -ECHILD;
+
 	rcu_read_lock();
 	inode = d_inode_rcu(dentry);
 	if (!inode)
@@ -2210,7 +2219,9 @@ static int map_files_d_revalidate(struct
 	mmput(mm);
 
 	if (exact_vma_exists) {
+		spin_lock(&inode->i_lock);
 		task_dump_owner(task, 0, &inode->i_uid, &inode->i_gid);
+		spin_unlock(&inode->i_lock);
 
 		security_task_to_inode(task, inode);
 		status = 1;
--- a/fs/proc/fd.c~proc-serialize-task-owner-lookup-and-inode-updates
+++ a/fs/proc/fd.c
@@ -127,6 +127,7 @@ static bool tid_fd_mode(struct task_stru
 static void tid_fd_update_inode(struct task_struct *task, struct inode *inode,
 				fmode_t f_mode)
 {
+	spin_lock(&inode->i_lock);
 	task_dump_owner(task, 0, &inode->i_uid, &inode->i_gid);
 
 	if (S_ISLNK(inode->i_mode)) {
@@ -137,6 +138,7 @@ static void tid_fd_update_inode(struct t
 			i_mode |= S_IWUSR | S_IXUSR;
 		inode->i_mode = i_mode;
 	}
+	spin_unlock(&inode->i_lock);
 	security_task_to_inode(task, inode);
 }
 
