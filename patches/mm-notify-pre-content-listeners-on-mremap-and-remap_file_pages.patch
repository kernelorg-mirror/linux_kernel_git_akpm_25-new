 mm/mmap.c   |    4 ++
 mm/mremap.c |   67 ++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 71 insertions(+)

--- a/mm/mmap.c~mm-notify-pre-content-listeners-on-mremap-and-remap_file_pages
+++ a/mm/mmap.c
@@ -23,6 +23,7 @@
 #include <linux/init.h>
 #include <linux/file.h>
 #include <linux/fs.h>
+#include <linux/fsnotify.h>
 #include <linux/personality.h>
 #include <linux/security.h>
 #include <linux/hugetlb.h>
@@ -1156,6 +1157,9 @@ SYSCALL_DEFINE5(remap_file_pages, unsign
 
 	/* Call outside mmap_lock to be consistent with other callers. */
 	ret = security_mmap_file(file, prot, flags);
+	if (!ret)
+		ret = fsnotify_mmap_perm(file, prot,
+					(loff_t)pgoff << PAGE_SHIFT, size);
 	if (ret) {
 		fput(file);
 		return ret;
--- a/mm/mremap.c~mm-notify-pre-content-listeners-on-mremap-and-remap_file_pages
+++ a/mm/mremap.c
@@ -17,6 +17,7 @@
 #include <linux/swap.h>
 #include <linux/capability.h>
 #include <linux/fs.h>
+#include <linux/fsnotify.h>
 #include <linux/leafops.h>
 #include <linux/highmem.h>
 #include <linux/security.h>
@@ -2025,6 +2026,65 @@ static unsigned long remap_move(struct v
 	return res;
 }
 
+/*
+ * A pre-content handler can wait for userspace.  Do not call it with
+ * mmap_lock held, and make sure the mapping still refers to the range
+ * for which the handler granted permission when we take the lock again.
+ */
+static int mremap_file_perm(struct vma_remap_struct *vrm)
+{
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma = vrm->vma;
+	struct file *file;
+	pgoff_t pgoff;
+	loff_t off;
+	int prot = 0;
+	int ret;
+
+	if (vrm->remap_type != MREMAP_EXPAND || !vma->vm_file ||
+	    !FMODE_FSNOTIFY_HSM(vma->vm_file->f_mode))
+		return 0;
+
+	file = get_file(vma->vm_file);
+	pgoff = linear_page_index(vma, vrm->addr);
+	off = (loff_t)(pgoff + (vrm->old_len >> PAGE_SHIFT)) << PAGE_SHIFT;
+	if (vma_test(vma, VMA_READ_BIT))
+		prot |= PROT_READ;
+	if (vma_test(vma, VMA_WRITE_BIT))
+		prot |= PROT_WRITE;
+	if (vma_test(vma, VMA_EXEC_BIT))
+		prot |= PROT_EXEC;
+
+	mmap_write_unlock(mm);
+	vrm->mmap_locked = false;
+	ret = fsnotify_mmap_perm(file, prot, off, vrm->delta);
+	if (ret)
+		goto out_file;
+
+	if (mmap_write_lock_killable(mm)) {
+		ret = -EINTR;
+		goto out_file;
+	}
+	vrm->mmap_locked = true;
+
+	vma = vma_lookup(mm, vrm->addr);
+	if (!vma || vma->vm_file != file ||
+	    linear_page_index(vma, vrm->addr) != pgoff) {
+		mmap_write_unlock(mm);
+		vrm->mmap_locked = false;
+		ret = -EAGAIN;
+		goto out_file;
+	}
+
+	/* The VMA may have changed while the lock was dropped. */
+	vrm->vma = vma;
+	vrm->populate_expand = false;
+	ret = check_prep_vma(vrm);
+out_file:
+	fput(file);
+	return ret;
+}
+
 static unsigned long do_mremap(struct vma_remap_struct *vrm)
 {
 	struct mm_struct *mm = current->mm;
@@ -2054,6 +2114,13 @@ static unsigned long do_mremap(struct vm
 		res = check_prep_vma(vrm);
 		if (res)
 			goto out;
+		res = mremap_file_perm(vrm);
+		if (res)
+			goto out;
+		if (!check_map_count_against_split_early(vrm)) {
+			res = -ENOMEM;
+			goto out;
+		}
 
 		/* Actually execute mremap. */
 		res = vrm_implies_new_addr(vrm) ? mremap_to(vrm) : mremap_at(vrm);
_
