--- a/tools/testing/selftests/mm/hugetlb_madv_vs_map.c~selftests-mm-fix-type-mismatch-warnings
+++ a/tools/testing/selftests/mm/hugetlb_madv_vs_map.c
@@ -100,7 +100,7 @@ int main(void)
