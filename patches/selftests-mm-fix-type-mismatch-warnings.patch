--- a/tools/testing/selftests/mm/compaction_test.c~selftests-mm-fix-type-mismatch-warnings
+++ a/tools/testing/selftests/mm/compaction_test.c
@@ -134,7 +134,7 @@ int check_compaction(unsigned long mem_f
