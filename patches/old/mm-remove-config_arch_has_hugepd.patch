@@ -3425,13 +3251,8 @@ static int gup_fast_p4d_range(pgd_t *pgd
 		if (!p4d_present(p4d))
 			return 0;
 		BUILD_BUG_ON(p4d_leaf(p4d));
-		if (unlikely(is_hugepd(__hugepd(p4d_val(p4d))))) {
