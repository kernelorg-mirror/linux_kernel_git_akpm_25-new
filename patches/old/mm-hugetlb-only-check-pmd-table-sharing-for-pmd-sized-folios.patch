 fs/proc/task_mmu.c      |    6 ++----
 include/linux/hugetlb.h |   16 ++++++++++++++++
 mm/mempolicy.c          |    2 +-
 3 files changed, 19 insertions(+), 5 deletions(-)

--- a/fs/proc/task_mmu.c~mm-hugetlb-only-check-pmd-table-sharing-for-pmd-sized-folios
+++ a/fs/proc/task_mmu.c
@@ -1211,8 +1211,7 @@ static int smaps_hugetlb_range(pte_t *pt
 
 	if (folio) {
 		/* We treat non-present entries as "maybe shared". */
-		if (!present || folio_maybe_mapped_shared(folio) ||
-		    hugetlb_pmd_shared(pte))
+		if (!present || hugetlb_folio_maybe_mapped_shared(folio, pte))
 			mss->shared_hugetlb += huge_page_size(hstate_vma(vma));
 		else
 			mss->private_hugetlb += huge_page_size(hstate_vma(vma));
@@ -2132,8 +2131,7 @@ static int pagemap_hugetlb_range(pte_t *
 		if (!folio_test_anon(folio))
 			flags |= PM_FILE;
 
-		if (!folio_maybe_mapped_shared(folio) &&
-		    !hugetlb_pmd_shared(ptep))
+		if (!hugetlb_folio_maybe_mapped_shared(folio, ptep))
 			flags |= PM_MMAP_EXCLUSIVE;
 
 		if (huge_pte_uffd(pte))
--- a/include/linux/hugetlb.h~mm-hugetlb-only-check-pmd-table-sharing-for-pmd-sized-folios
+++ a/include/linux/hugetlb.h
@@ -1386,6 +1386,22 @@ static inline bool hugetlb_pmd_shared(pt
 }
 #endif
 
+#ifdef CONFIG_HUGETLB_PAGE
+static inline bool hugetlb_folio_maybe_mapped_shared(struct folio *folio,
+		pte_t *ptep)
+{
+	if (folio_maybe_mapped_shared(folio))
+		return true;
+	return folio_size(folio) == PMD_SIZE && hugetlb_pmd_shared(ptep);
+}
+#else /* !CONFIG_HUGETLB_PAGE */
+static inline bool hugetlb_folio_maybe_mapped_shared(struct folio *folio,
+		pte_t *ptep)
+{
+	return true;
+}
+#endif /* CONFIG_HUGETLB_PAGE */
+
 bool want_pmd_share(struct vm_area_struct *vma, unsigned long addr);
 
 #ifndef __HAVE_ARCH_FLUSH_HUGETLB_TLB_RANGE
--- a/mm/mempolicy.c~mm-hugetlb-only-check-pmd-table-sharing-for-pmd-sized-folios
+++ a/mm/mempolicy.c
@@ -833,7 +833,7 @@ static int queue_folios_hugetlb(pte_t *p
 	 * cannot easily detect if a folio is shared.
 	 */
 	if ((flags & MPOL_MF_MOVE_ALL) ||
-	    (!folio_maybe_mapped_shared(folio) && !hugetlb_pmd_shared(pte)))
+	    !hugetlb_folio_maybe_mapped_shared(folio, pte))
 		if (!folio_isolate_hugetlb(folio, qp->pagelist))
 			qp->nr_failed++;
 unlock:
