 1 file changed, 48 insertions(+), 35 deletions(-)

--- a/tools/testing/selftests/proc/proc-maps-race.c~proc-maps-race-followup
+++ a/tools/testing/selftests/proc/proc-maps-race.c
@@ -62,7 +62,6 @@ struct line_content {
 
