 1 file changed, 2 insertions(+), 1 deletion(-)

--- a/mm/vma.c~mm-vma-return-the-exact-errno-in-vms_gather_munmap_vmas-fix
+++ a/mm/vma.c
@@ -1260,7 +1260,8 @@ int vms_gather_munmap_vmas(struct vma_mu
