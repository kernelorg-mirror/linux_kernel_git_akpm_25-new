 fs/hugetlbfs/inode.c |    6 ++----
 mm/hugetlb.c         |    3 +--
 mm/rmap.c            |    4 ++--
 3 files changed, 5 insertions(+), 8 deletions(-)

--- a/fs/hugetlbfs/inode.c~hugetlbfs-fix-deadlock-between-hole-punching-and-memory-failure
+++ a/fs/hugetlbfs/inode.c
@@ -684,8 +684,6 @@ static long hugetlbfs_punch_hole(struct
 		return -EPERM;
 	}
 
-	i_mmap_lock_write(mapping);
-
 	/* If range starts before first full page, zero partial page. */
 	if (offset < hole_start)
 		hugetlbfs_zero_partial_page(h, mapping,
@@ -693,10 +691,12 @@ static long hugetlbfs_punch_hole(struct
 
 	/* Unmap users of full pages in the hole. */
 	if (hole_end > hole_start) {
+		i_mmap_lock_write(mapping);
 		if (mapping_mapped(mapping))
 			hugetlb_vmdelete_list(mapping,
 					      hole_start >> PAGE_SHIFT,
 					      hole_end >> PAGE_SHIFT, 0);
+		i_mmap_unlock_write(mapping);
 	}
 
 	/* If range extends beyond last full page, zero partial page. */
@@ -704,8 +704,6 @@ static long hugetlbfs_punch_hole(struct
 		hugetlbfs_zero_partial_page(h, mapping,
 				hole_end, offset + len);
 
-	i_mmap_unlock_write(mapping);
-
 	/* Remove full pages from the file. */
 	if (hole_end > hole_start)
 		remove_inode_hugepages(inode, hole_start, hole_end);
--- a/mm/hugetlb.c~hugetlbfs-fix-deadlock-between-hole-punching-and-memory-failure
+++ a/mm/hugetlb.c
@@ -1871,8 +1871,7 @@ void init_new_hugetlb_folio(struct folio
  * Find and lock address space (mapping) in write mode.
  *
  * Upon entry, the folio is locked which means that folio_mapping() is
- * stable.  Due to locking order, we can only trylock_write.  If we can
- * not get the lock, simply return NULL to caller.
+ * stable. If we cannot get the lock immediately, we simply return NULL.
  */
 struct address_space *hugetlb_folio_mapping_lock_write(struct folio *folio)
 {
--- a/mm/rmap.c~hugetlbfs-fix-deadlock-between-hole-punching-and-memory-failure
+++ a/mm/rmap.c
@@ -49,8 +49,8 @@
  *   hugetlb_fault_mutex (hugetlbfs specific page fault mutex)
  *     vma_lock (hugetlb specific lock for pmd_sharing)
  *       mapping->invalidate_lock (when allocating page cache folios)
- *         mapping->i_mmap_rwsem (also used for hugetlb pmd sharing)
- *           folio_lock
+ *         folio_lock
+ *           mapping->i_mmap_rwsem (also used for hugetlb pmd sharing)
  */
 
 #include <linux/mm.h>
