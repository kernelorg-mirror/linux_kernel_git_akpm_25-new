From: Zhengchuan Liang <zcliangcn@gmail.com>
Subject: mm/hugetlb: stop hashing address_space pointers for fault mutexes
Date: Tue, 24 Nov 2026 22:15:21 -0800

hugetlb_fault_mutex_hash() uses the address_space pointer and page index
to select an entry in a global mutex table.  An unprivileged user can
create a no-reserve HugeTLB memfd with an empty huge page pool, build
contention on one index, and time SIGBUS faults at chosen indices. 
Pointer-dependent mutex collisions expose equations that recover the exact
address_space address.

Give each hugetlbfs inode a dedicated random hash seed instead, and hash
the page index with that value.  Operations on the same mapping continue
to select the same mutex, while separate mappings retain independent
bucket distributions without encoding an address.  The seed is not relied
upon as a secret and is not reused by another hash table.

Link: https://patch.msgid.link/9a97a64f7e7aabc668499c426a2417a77d13a2f4.1795587203.git.zcliangcn@gmail.com
Fixes: 8382d914ebf7 ("mm, hugetlb: improve page-fault scalability")
Signed-off-by: Zhengchuan Liang <zcliangcn@gmail.com>
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
Cc: Muchun Song <muchun.song@linux.dev>
Cc: Oscar Salvador <osalvador@suse.de>
Cc: David Hildenbrand <david@kernel.org>
Cc: Davidlohr Bueso <davidlohr@hp.com>
Cc: <stable@vger.kernel.org>

 fs/hugetlbfs/inode.c    |    2 ++
 include/linux/hugetlb.h |    1 +
 mm/hugetlb.c            |    9 ++-------
 3 files changed, 5 insertions(+), 7 deletions(-)

--- a/fs/hugetlbfs/inode.c~mm-hugetlb-stop-hashing-address_space-pointers-for-fault-mutexes
+++ a/fs/hugetlbfs/inode.c
@@ -35,6 +35,7 @@
 #include <linux/security.h>
 #include <linux/magic.h>
 #include <linux/migrate.h>
+#include <linux/random.h>
 #include <linux/uio.h>
 
 #include <linux/uaccess.h>
@@ -1204,6 +1205,7 @@ static struct inode *hugetlbfs_alloc_ino
 		hugetlbfs_inc_free_inodes(sbinfo);
 		return NULL;
 	}
+	p->fault_mutex_hash_seed = get_random_u32();
 	return &p->vfs_inode;
 }
 
--- a/include/linux/hugetlb.h~mm-hugetlb-stop-hashing-address_space-pointers-for-fault-mutexes
+++ a/include/linux/hugetlb.h
@@ -504,6 +504,7 @@ static inline struct hugetlbfs_sb_info *
 struct hugetlbfs_inode_info {
 	struct inode vfs_inode;
 	struct resv_map *resv_map;
+	u32 fault_mutex_hash_seed;
 	unsigned int seals;
 #ifdef CONFIG_HUGETLB_PMD_PAGE_TABLE_SHARING
 	atomic64_t pmd_sharing_count;
--- a/mm/hugetlb.c~mm-hugetlb-stop-hashing-address_space-pointers-for-fault-mutexes
+++ a/mm/hugetlb.c
@@ -6153,13 +6153,8 @@ backout_unlocked:
 #ifdef CONFIG_SMP
 u32 hugetlb_fault_mutex_hash(struct address_space *mapping, pgoff_t idx)
 {
-	unsigned long key[2];
-	u32 hash;
-
-	key[0] = (unsigned long) mapping;
-	key[1] = idx;
-
-	hash = jhash2((u32 *)&key, sizeof(key)/(sizeof(u32)), 0);
+	u32 seed = HUGETLBFS_I(mapping->host)->fault_mutex_hash_seed;
+	u32 hash = jhash2((u32 *)&idx, sizeof(idx) / sizeof(u32), seed);
 
 	return hash & (num_fault_mutexes - 1);
 }
_
