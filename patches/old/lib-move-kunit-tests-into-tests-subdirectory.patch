-static void __strchrcut(char *dst, const char *src, const char *cut)
-{
-	const char *from = src;
-	size_t len;
-
-	do {
-		len = strcspn(from, cut);
-		memcpy(dst, from, len);
-		dst += len;
-		from += len;
-	} while (*from++);
-	*dst = '\0';
-}
