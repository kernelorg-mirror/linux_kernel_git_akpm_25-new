-#define check_self_op(fmt, op, sym, a, b) do {				\
-	typeof(a + 0) _a = a;						\
-	typeof(b + 0) _b = b;						\
-	typeof(a + 0) _a_sym = a;					\
-	typeof(a + 0) _a_orig[1] = { a };				\
-	typeof(b + 0) _b_orig = b;					\
-	typeof(b + 0) _b_bump = b + 1;					\
-	typeof(a + 0) _r;						\
-									\
-	_a_sym sym _b;							\
-	_r = wrapping_ ## op(_a, _b);					\
-	KUNIT_EXPECT_TRUE_MSG(test, _r == _a_sym,			\
-		"expected "fmt" "#op" "fmt" == "fmt", got "fmt"\n",	\
-		a, b, _a_sym, _r);					\
