-static struct kunit_case usercopy_test_cases[] = {
-	KUNIT_CASE(usercopy_test_valid),
-	KUNIT_CASE(usercopy_test_invalid),
-	KUNIT_CASE(usercopy_test_check_nonzero_user),
-	KUNIT_CASE(usercopy_test_copy_struct_from_user),
-	{}
-};
