-		asm volatile("vpand %ymm7, %ymm6, %ymm6");
-		asm volatile("vpshufb %ymm3, %ymm0, %ymm0");
-		asm volatile("vpshufb %ymm6, %ymm1, %ymm1");
-		asm volatile("vpxor %ymm0, %ymm1, %ymm1");
