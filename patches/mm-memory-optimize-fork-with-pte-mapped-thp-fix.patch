+++ a/mm/memory.c
@@ -1031,7 +1031,7 @@ copy_present_ptes(struct vm_area_struct
 		} else {
 			folio_ref_add(folio, nr);
 			folio_dup_file_rmap_ptes(folio, page, nr);
