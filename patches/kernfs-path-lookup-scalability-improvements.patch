+static void kernfs_iattr_seq_begin(struct kernfs_root *root)
+{
+	lockdep_assert_held_write(&root->kernfs_iattr_rwsem);
+	raw_write_seqcount_begin(&root->iattr_seq);
+}
+
+static void kernfs_iattr_seq_end(struct kernfs_root *root)
+{
+	raw_write_seqcount_end(&root->iattr_seq);
+}
