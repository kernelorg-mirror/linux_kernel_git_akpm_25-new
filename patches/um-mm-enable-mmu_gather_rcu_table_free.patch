 arch/um/Kconfig |    1 +
 1 file changed, 1 insertion(+)

--- a/arch/um/Kconfig~um-mm-enable-mmu_gather_rcu_table_free
+++ a/arch/um/Kconfig
@@ -42,6 +42,7 @@ config UML
 	select HAVE_SYSCALL_TRACEPOINTS
 	select THREAD_INFO_IN_TASK
 	select SPARSE_IRQ
+	select MMU_GATHER_RCU_TABLE_FREE
 
 config MMU
 	bool
