From: Andrew Morton <akpm@linux-foundation.org>
Subject: net: copy pagecache data when socket splice hits refcount limit
Date: Sat, 07 Nov 2026 21:49:08 -0800

The pagecache refcount checks in the five-patch series cover insertion
into a pipe, but a pipe buffer can subsequently supply the same page to an
skb.  skb_append_pagefrags() takes another reference without checking the
limit.  TCP receive splice similarly takes a reference when transferring
an skb fragment into a pipe.  Local users can reach both paths through
ordinary sockets and splice().

Refuse the extra skb reference at the limit and copy the source page into
a private page in skb_splice_from_iter().  Checksum the actual page
attached to the skb.  On the receive side, copy into the socket's page
fragment instead of retaining another reference to the original page.  If
the copy cannot be allocated, return an error when no bytes were spliced;
preserve the partial byte count otherwise.  Some callers map the error to
their own splice errno.

The checks only precede new references.  Coalescing with an existing skb
fragment or pipe buffer remains possible without another folio ref.  This
depends on folio_ref_count_over_limit() in the preceding series.  The send
copy uses atomic allocation because this helper also serves sockets that
do not permit sleeping allocations.

Fixes: 800d8c63b2e9 ("shmem: add huge pages support")
Fixes: 99cb0dbd47a1 ("mm,thp: add read-only THP support for (non-shmem) FS")
Fixes: 793917d997df ("mm/readahead: Add large folio readahead")
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
Cc: David Hildenbrand <david@kernel.org>
Cc: <stable@vger.kernel.org>
---

 net/core/skbuff.c |   70 ++++++++++++++++++++++++++++++--------------
 1 file changed, 49 insertions(+), 21 deletions(-)

--- a/net/core/skbuff.c~net-splice-pagecache-refcount
+++ a/net/core/skbuff.c
@@ -3128,8 +3128,8 @@ static struct page *linear_to_page(struc
 
 	*len = min_t(unsigned int, *len, pfrag->size - pfrag->offset);
 
-	memcpy(page_address(pfrag->page) + pfrag->offset,
-	       page_address(page) + *offset, *len);
+	memcpy_from_page(page_address(pfrag->page) + pfrag->offset,
+			 page, *offset, *len);
 	*offset = pfrag->offset;
 	pfrag->offset += *len;
 
@@ -3151,20 +3151,34 @@ static bool spd_can_coalesce(const struc
  */
 static bool spd_fill_page(struct splice_pipe_desc *spd, struct page *page,
 			  unsigned int *len, unsigned int offset, bool linear,
-			  struct sock *sk)
+			  struct sock *sk, int *error)
 {
 	if (unlikely(spd->nr_pages == MAX_SKB_FRAGS))
 		return true;
 
 	if (linear) {
 		page = linear_to_page(page, len, &offset, sk);
-		if (!page)
+		if (!page) {
+			*error = -ENOMEM;
 			return true;
+		}
 	}
 	if (spd_can_coalesce(spd, page, offset)) {
 		spd->partial[spd->nr_pages - 1].len += *len;
 		return false;
 	}
+	if (unlikely(folio_ref_count_over_limit(page_folio(page)))) {
+		/* Retain the bytes without retaining the original folio. */
+		page = linear_to_page(page, len, &offset, sk);
+		if (!page) {
+			*error = -ENOMEM;
+			return true;
+		}
+		if (spd_can_coalesce(spd, page, offset)) {
+			spd->partial[spd->nr_pages - 1].len += *len;
+			return false;
+		}
+	}
 	get_page(page);
 	spd->pages[spd->nr_pages] = page;
 	spd->partial[spd->nr_pages].len = *len;
@@ -3178,7 +3192,7 @@ static bool __splice_segment(struct page
 			     unsigned int plen, unsigned int *off,
 			     unsigned int *len,
 			     struct splice_pipe_desc *spd, bool linear,
-			     struct sock *sk)
+			     struct sock *sk, int *error)
 {
 	if (!*len)
 		return true;
@@ -3197,7 +3211,7 @@ static bool __splice_segment(struct page
 	do {
 		unsigned int flen = min(*len, plen);
 
-		if (spd_fill_page(spd, page, &flen, poff, linear, sk))
+		if (spd_fill_page(spd, page, &flen, poff, linear, sk, error))
 			return true;
 		poff += flen;
 		plen -= flen;
@@ -3211,11 +3225,12 @@ static bool __splice_segment(struct page
 
 /*
  * Map linear and fragment data from the skb to spd. It reports true if the
- * pipe is full or if we already spliced the requested length.
+ * pipe is full, an allocation failed or we spliced the requested length.
  */
 static bool __skb_splice_bits(struct sk_buff *skb, struct pipe_inode_info *pipe,
 			      unsigned int *offset, unsigned int *len,
-			      struct splice_pipe_desc *spd, struct sock *sk)
+			      struct splice_pipe_desc *spd, struct sock *sk,
+			      int *error)
 {
 	struct sk_buff *iter;
 	int seg;
@@ -3230,7 +3245,7 @@ static bool __skb_splice_bits(struct sk_
 			     skb_headlen(skb),
 			     offset, len, spd,
 			     skb_head_is_locked(skb),
-			     sk))
+			     sk, error))
 		return true;
 
 	/*
@@ -3247,7 +3262,7 @@ static bool __skb_splice_bits(struct sk_
 
 		if (__splice_segment(skb_frag_page(f),
 				     skb_frag_off(f), skb_frag_size(f),
-				     offset, len, spd, false, sk))
+				     offset, len, spd, false, sk, error))
 			return true;
 	}
 
@@ -3256,11 +3271,9 @@ static bool __skb_splice_bits(struct sk_
 			*offset -= iter->len;
 			continue;
 		}
-		/* __skb_splice_bits() only fails if the output has no room
-		 * left, so no point in going over the frag_list for the error
-		 * case.
-		 */
-		if (__skb_splice_bits(iter, pipe, offset, len, spd, sk))
+		/* An error or a full output stops the frag_list walk. */
+		if (__skb_splice_bits(iter, pipe, offset, len, spd, sk,
+				      error))
 			return true;
 	}
 
@@ -3284,14 +3297,14 @@ int skb_splice_bits(struct sk_buff *skb,
 		.ops = &nosteal_pipe_buf_ops,
 		.spd_release = sock_spd_release,
 	};
-	int ret = 0;
+	int ret = 0, error = 0;
 
-	__skb_splice_bits(skb, pipe, &offset, &tlen, &spd, sk);
+	__skb_splice_bits(skb, pipe, &offset, &tlen, &spd, sk, &error);
 
 	if (spd.nr_pages)
 		ret = splice_to_pipe(pipe, &spd);
 
-	return ret;
+	return ret ?: error;
 }
 EXPORT_SYMBOL_GPL(skb_splice_bits);
 
@@ -4691,6 +4704,8 @@ int skb_append_pagefrags(struct sk_buff
 	if (skb_can_coalesce(skb, i, page, offset)) {
 		skb_frag_size_add(&skb_shinfo(skb)->frags[i - 1], size);
 	} else if (i < max_frags) {
+		if (unlikely(folio_ref_count_over_limit(page_folio(page))))
+			return -EOVERFLOW;
 		skb_zcopy_downgrade_managed(skb);
 		get_page(page);
 		skb_fill_page_desc_noacc(skb, i, page, offset, size);
@@ -7554,8 +7569,8 @@ static void skb_splice_csum_page(struct
  * possible, copying them to fragments if not possible (such as if they're slab
  * pages).
  *
- * Returns the amount of data spliced/copied or -EMSGSIZE if there's
- * insufficient space in the buffer to transfer anything.
+ * Returns the amount of data spliced/copied, -EMSGSIZE if there is no
+ * fragment space, or -ENOMEM if copying at the refcount limit fails.
  */
 ssize_t skb_splice_from_iter(struct sk_buff *skb, struct iov_iter *iter,
 			     ssize_t maxsize)
@@ -7586,6 +7601,7 @@ ssize_t skb_splice_from_iter(struct sk_b
 		i = 0;
 		do {
 			struct page *page = pages[i++];
+			struct page *copy_page = NULL, *frag_page = page;
 			size_t part = min_t(size_t, PAGE_SIZE - off, len);
 
 			ret = -EIO;
@@ -7594,13 +7610,25 @@ ssize_t skb_splice_from_iter(struct sk_b
 
 			ret = skb_append_pagefrags(skb, page, off, part,
 						   frag_limit);
+			if (ret == -EOVERFLOW) {
+				copy_page = alloc_page(GFP_ATOMIC);
+				if (!copy_page) {
+					ret = -ENOMEM;
+				} else {
+					copy_highpage(copy_page, page);
+					ret = skb_append_pagefrags(skb, copy_page,
+								   off, part, frag_limit);
+					frag_page = copy_page;
+					put_page(copy_page);
+				}
+			}
 			if (ret < 0) {
 				iov_iter_revert(iter, len);
 				goto out;
 			}
 
 			if (skb->ip_summed == CHECKSUM_NONE)
-				skb_splice_csum_page(skb, page, off, part,
+				skb_splice_csum_page(skb, frag_page, off, part,
 						     skb->len + spliced);
 
 			off = 0;
_
