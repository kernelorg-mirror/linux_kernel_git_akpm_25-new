 	result = hugepage_vma_revalidate(mm, address, &vma);
@@ -1236,10 +1240,9 @@ static int khugepaged_scan_pmd(struct mm
 out_unmap:
 	pte_unmap_unlock(pte, ptl);
 	if (ret) {
