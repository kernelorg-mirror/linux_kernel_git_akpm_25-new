--- a/include/linux/highmem.h~mm-highmem-reject-previously-poisoned-pages-in-machine-check-copies
+++ a/include/linux/highmem.h
@@ -437,6 +437,9 @@ static inline int copy_mc_user_highpage(
 	unsigned long ret;
 	char *vfrom, *vto;
 
+	if (is_page_hwpoison(from))
+		return PAGE_SIZE;
+
 	vfrom = kmap_local_page(from);
 	vto = kmap_local_page(to);
 	ret = copy_mc_to_kernel(vto, vfrom, PAGE_SIZE);
@@ -456,6 +459,9 @@ static inline int copy_mc_highpage(struc
 	unsigned long ret;
 	char *vfrom, *vto;
 
+	if (is_page_hwpoison(from))
+		return PAGE_SIZE;
+
 	vfrom = kmap_local_page(from);
 	vto = kmap_local_page(to);
 	ret = copy_mc_to_kernel(vto, vfrom, PAGE_SIZE);
--- a/mm/util.c~mm-highmem-reject-previously-poisoned-pages-in-machine-check-copies
+++ a/mm/util.c
