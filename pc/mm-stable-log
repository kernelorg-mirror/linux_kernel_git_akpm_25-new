        pgsteal_kswapd 0
        pgsteal_direct 0
        pgsteal_khugepaged 0
        pgsteal_proactive 0
        pgsteal_anon 0
        pgsteal_file 0
        # echo "64M swappiness=max" > /sys/devices/system/node/node0/reclaim
        # cat /proc/vmstat | grep pgsteal
        pgsteal_kswapd 0
        pgsteal_direct 0
        pgsteal_khugepaged 0
